PORT=3000

# Cách 1 (khuyên dùng cho Supabase): dán nguyên connection string
# Project Settings -> Database -> Connection string -> URI
# Dùng "Connection pooling" (port 6543, chế độ transaction) cho app chạy nhiều
# request đồng thời, hoặc "Direct connection" (port 5432) nếu ít kết nối.
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Cách 2: khai từng phần (dùng khi không có DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_CONNECTION_LIMIT=10
DB_SSL=true

# Ngưỡng amount (VND) để tự động tạo fraud_alerts (api-design.md mục 3)
FRAUD_AMOUNT_THRESHOLD=50000000

# Khóa ký JWT cho đăng nhập app_users (maker-checker) — tạo bằng
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# và giữ bí mật, không commit giá trị thật lên git.
JWT_SECRET=
JWT_EXPIRES_IN=8h
